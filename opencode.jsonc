{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  },

  "instructions": [
    "AGENTS.md",
    ".codex/README.md",
    ".codex/current-state.md",
    ".codex/review-checklist.md"
  ],

  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "ask",
    "bash": {
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git show*": "allow",
      "ls*": "allow",
      "./mvnw test*": "allow",
      "./mvnw verify*": "allow",
      "rg*": "allow",
      "*": "ask"
    },
    "skill": "allow",
    "webfetch": "ask",
    "websearch": "ask"
  }
}

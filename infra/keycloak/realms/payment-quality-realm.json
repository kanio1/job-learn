          "value": "platform.payment.admin",
          "temporary": false
        }
      ],
      "realmRoles": ["platform:payments:read", "platform:payments:lifecycle"]
    },
    {
      "username": "platform.payment.auditor",
      "enabled": true,
      "firstName": "Platform Payment",
      "lastName": "Auditor",
      "email": "platform.payment.auditor@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "platform.payment.auditor",
          "temporary": false
        }
      ],
      "realmRoles": ["platform:payments:read", "platform:payments:audit"]
    }
  ]
}

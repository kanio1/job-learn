{
  "id": "payment-quality",
  "realm": "payment-quality",
  "enabled": true,
  "displayName": "Payment Quality Engineering Lab",
  "roles": {
    "realm": [
      {"name": "merchants:create"},
      {"name": "merchants:read"},
      {"name": "merchants:update-status"},
      {"name": "merchant:payments:create"},
      {"name": "merchant:payments:read"},
      {"name": "merchant:payments:operate"},
      {"name": "merchant:payments:lifecycle"},
      {"name": "platform:payments:read"},
      {"name": "platform:payments:lifecycle"},
      {"name": "platform:payments:audit"},
      {
        "name": "PLATFORM_ADMIN",
        "composite": true,
        "composites": {
          "realm": [
            "merchants:create",
            "merchants:read",
            "merchants:update-status",
            "platform:payments:read",
            "platform:payments:lifecycle",
            "platform:payments:audit"
          ]
        }
      },
      {
        "name": "TENANT_ADMIN",
        "composite": true,
        "composites": {
          "realm": [
            "merchants:create",
            "merchants:read",
            "merchants:update-status",
            "merchant:payments:read"
          ]
        }
      },
      {
        "name": "MERCHANT_MANAGER",
        "composite": true,
        "composites": {
          "realm": [
            "merchant:payments:create",
            "merchant:payments:read",
            "merchant:payments:lifecycle"
          ]
        }
      },
      {
        "name": "SUPPORT_AGENT",
        "composite": true,
        "composites": {
          "realm": [
            "merchants:read",
            "platform:payments:read",
            "platform:payments:audit"
          ]
        }
      },
      {
        "name": "READ_ONLY_USER",
        "composite": true,
        "composites": {
          "realm": [
            "merchants:read",
            "platform:payments:read"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "payment-quality-dashboard",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "merchant-id-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "merchant_id",
            "claim.name": "merchant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "tenant-id-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "platform.operator",
      "enabled": true,
      "firstName": "Platform",
      "lastName": "Operator",
      "email": "platform.operator@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "platform.operator",
          "temporary": false
        }
      ],
      "realmRoles": ["merchants:create", "merchants:read", "merchants:update-status"]
    },
    {
      "username": "merchant.denied",
      "enabled": true,
      "firstName": "Merchant",
      "lastName": "Denied",
      "email": "merchant.denied@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "merchant.denied",
          "temporary": false
        }
      ],
      "realmRoles": []
    },
    {
      "username": "merchant.payment.creator",
      "enabled": false,
      "firstName": "Merchant Payment",
      "lastName": "Creator",
      "email": "merchant.payment.creator@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "merchant.payment.creator",
          "temporary": false
        }
      ],
      "attributes": {
        "merchant_id": "PLACEHOLDER_MERCHANT_ID"
      },
      "realmRoles": ["merchant:payments:create"]
    },
    {
      "username": "merchant.payment.reader",
      "enabled": false,
      "firstName": "Merchant Payment",
      "lastName": "Reader",
      "email": "merchant.payment.reader@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "merchant.payment.reader",
          "temporary": false
        }
      ],
      "attributes": {
        "merchant_id": "PLACEHOLDER_MERCHANT_ID"
      },
      "realmRoles": ["merchant:payments:read"]
    },
    {
      "username": "merchant.payment.operator",
      "enabled": false,
      "firstName": "Merchant Payment",
      "lastName": "Operator",
      "email": "merchant.payment.operator@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "merchant.payment.operator",
          "temporary": false
        }
      ],
      "attributes": {
        "merchant_id": "PLACEHOLDER_MERCHANT_ID"
      },
      "realmRoles": ["merchant:payments:operate"]
    },
    {
      "username": "platform.payment.reader",
      "enabled": true,
      "firstName": "Platform Payment",
      "lastName": "Reader",
      "email": "platform.payment.reader@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "platform.payment.reader",
          "temporary": false
        }
      ],
      "realmRoles": ["platform:payments:read"]
    },
    {
      "username": "merchant.payment.lifecycle",
      "enabled": true,
      "firstName": "Merchant Payment",
      "lastName": "Lifecycle",
      "email": "merchant.payment.lifecycle@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "merchant.payment.lifecycle",
          "temporary": false
        }
      ],
      "attributes": {
        "merchant_id": "PLACEHOLDER_MERCHANT_ID"
      },
      "realmRoles": ["merchant:payments:create", "merchant:payments:read", "merchant:payments:lifecycle"]
